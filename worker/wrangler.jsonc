// The portfolio chatbot. Deployed by hand from this folder — see README.md —
// because it only changes when the prompt or the portfolio data does.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",

  // The fallback model, when Gemini is rate-limited or down.
  "ai": { "binding": "AI" },

  // Per visitor IP, per Cloudflare location: a burst of questions is fine, a
  // script hammering the endpoint is not. `period` may only be 10 or 60.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }
  ],

  "vars": {
    // Pages that may call this. Local development adds its own in .dev.vars.
    "ALLOWED_ORIGINS": "https://youssefsayed88.github.io"
  }

  // GEMINI_API_KEY is a secret: `npx wrangler secret put GEMINI_API_KEY`.
}
